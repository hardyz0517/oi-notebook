{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oi-notebook",
  "version": "1.0.0",
  "identifier": "io.github.hardyz0517.oi-notebook",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:local-blog",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oi-notebook",
        "width": 1520,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false
      },
      {
        "label": "quick-note",
        "title": "速记",
        "url": "quick-note.html",
        "width": 600,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../local-blog/dist": "local-blog/dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
