---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const sortedNotes = (await getCollection("notes")).sort((a, b) => {
  const aTime = (a.data.updated ?? a.data.created)?.getTime() ?? 0;
  const bTime = (b.data.updated ?? b.data.created)?.getTime() ?? 0;
  return bTime - aTime;
});
const currentIndex = sortedNotes.findIndex((entry) => entry.id === note.id);
const newerNote = currentIndex > 0 ? sortedNotes[currentIndex - 1] : undefined;
const olderNote =
  currentIndex >= 0 && currentIndex < sortedNotes.length - 1
    ? sortedNotes[currentIndex + 1]
    : undefined;

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(date)
    : "未记录";

const category = note.id.split(/[\\/]/)[0] || "notes";
const categoryHref = (category: string) => `/categories/${category}`;
const tagHref = (tag: string) => `/tags/${encodeURIComponent(tag.trim())}`;
---

<BaseLayout
  title={`${note.data.title || note.id} - OI Notebook`}
  description={note.data.summary || "OI Notebook note"}
  mainClass="post-main-shell"
>
  <article class="post">
    <header class="post-header">
      <div class="post-meta">
        <a class="category" href={categoryHref(category)}>{category}</a>
        {note.data.draft && <span class="draft-badge">Draft</span>}
      </div>
      <h1>{note.data.title || note.id}</h1>
      <dl class="frontmatter-list">
        <div>
          <dt>创建</dt>
          <dd>{formatDate(note.data.created)}</dd>
        </div>
        <div>
          <dt>更新</dt>
          <dd>{formatDate(note.data.updated ?? note.data.created)}</dd>
        </div>
        {
          note.data.difficulty && (
            <div>
              <dt>难度</dt>
              <dd>{note.data.difficulty}</dd>
            </div>
          )
        }
        {
          note.data.source && (
            <div>
              <dt>来源</dt>
              <dd>{note.data.source}</dd>
            </div>
          )
        }
      </dl>
      {
        note.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="标签">
            {note.data.tags.map((tag) => {
              const normalizedTag = tag.trim();

              if (!normalizedTag) {
                return null;
              }

              return (
                <li>
                  {normalizedTag.includes("/") ? (
                    normalizedTag
                  ) : (
                    <a href={tagHref(normalizedTag)}>{normalizedTag}</a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </header>

    <div class={`post-layout ${tocHeadings.length > 1 ? "has-toc" : "no-toc"}`}>
      {
        tocHeadings.length > 1 && (
          <nav class="post-toc" aria-label="文章目录">
            <h2>目录</h2>
            <ol>
              {tocHeadings.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="post-main">
        <div class="prose">
          <Content />
        </div>
        {
          sortedNotes.length > 1 && (newerNote || olderNote) && (
            <nav class="post-nav" aria-label="上一篇和下一篇">
              {newerNote && (
                <a class="post-nav-item previous" href={`/posts/${newerNote.id}`}>
                  <span class="post-nav-label">上一篇</span>
                  <strong>{newerNote.data.title || newerNote.id}</strong>
                  <time datetime={(newerNote.data.updated ?? newerNote.data.created)?.toISOString()}>
                    {formatDate(newerNote.data.updated ?? newerNote.data.created)}
                  </time>
                </a>
              )}
              {olderNote && (
                <a class="post-nav-item next" href={`/posts/${olderNote.id}`}>
                  <span class="post-nav-label">下一篇</span>
                  <strong>{olderNote.data.title || olderNote.id}</strong>
                  <time datetime={(olderNote.data.updated ?? olderNote.data.created)?.toISOString()}>
                    {formatDate(olderNote.data.updated ?? olderNote.data.created)}
                  </time>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
