---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const showDrafts = !import.meta.env.PROD;
const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const cleanPath = path.replace(/^\/+/, "");

  return cleanPath ? `${base}/${cleanPath}` : `${base}/`;
};
const notes = (await getCollection("notes")).filter((note) => showDrafts || !note.data.draft);

const sortedNotes = notes.sort((a, b) => {
  const aTime = (a.data.updated ?? a.data.created)?.getTime() ?? 0;
  const bTime = (b.data.updated ?? b.data.created)?.getTime() ?? 0;
  return bTime - aTime;
});

const featuredNote = sortedNotes[0];
const restNotes = sortedNotes.slice(1);

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(date)
    : "未记录日期";

const categoryOf = (id: string) => id.split(/[\\/]/)[0] || "notes";
const postHref = (id: string) => withBase(`/posts/${id}`);
const categoryHref = (category: string) => withBase(`/categories/${category}`);
const tagHref = (tag: string) => withBase(`/tags/${encodeURIComponent(tag.trim())}`);

const excerptOf = (note: (typeof sortedNotes)[number]) => {
  const summary = note.data.summary?.trim() ?? "";

  if (summary) {
    return summary;
  }

  const rawBody = note.body ?? "";
  const body = rawBody
    .replace(/^---[\s\S]*?---/, "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/^\s{0,3}#{1,6}\s*/gm, "")
    .replace(/^\s{0,3}[-*+]\s+/gm, "")
    .replace(/^\s{0,3}>\s?/gm, "")
    .replace(/\$\$?/g, "")
    .replace(/\\(frac|sum|int|lim|sqrt|cdot|times|leq|geq|neq|infty)\b/g, "$1")
    .replace(/\s+/g, " ")
    .trim();

  return body.length > 110 ? `${body.slice(0, 110)}...` : body;
};
---

<BaseLayout title="OI Notebook">
  <section class="home-posts" id="posts" aria-label="笔记列表">
    {
      sortedNotes.length === 0 ? (
        <p class="empty-state">还没有 Markdown 笔记。开始在桌面端写一篇，博客会在这里显示。</p>
      ) : (
        <>
          <article class="featured-post">
            <div class="post-meta">
              <a class="category" href={categoryHref(categoryOf(featuredNote.id))}>
                {categoryOf(featuredNote.id)}
              </a>
              <time datetime={(featuredNote.data.updated ?? featuredNote.data.created)?.toISOString()}>
                {formatDate(featuredNote.data.updated ?? featuredNote.data.created)}
              </time>
              {featuredNote.data.draft && <span class="draft-badge">Draft</span>}
            </div>
            <h2>
              <a href={postHref(featuredNote.id)}>{featuredNote.data.title || featuredNote.id}</a>
            </h2>
            {excerptOf(featuredNote) && <p class="summary">{excerptOf(featuredNote)}</p>}
            {featuredNote.data.tags.length > 0 && (
              <ul class="tag-list" aria-label="标签">
                {featuredNote.data.tags.map((tag) => {
                  const normalizedTag = tag.trim();

                  if (!normalizedTag) {
                    return null;
                  }

                  return (
                    <li>
                      {normalizedTag.includes("/") ? (
                        normalizedTag
                      ) : (
                        <a href={tagHref(normalizedTag)}>{normalizedTag}</a>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
            <a class="read-more" href={postHref(featuredNote.id)}>阅读更多</a>
          </article>

          {restNotes.length > 0 && (
            <div class="post-list" aria-label="更多笔记">
              {restNotes.map((note) => {
                const date = note.data.updated ?? note.data.created;
                const excerpt = excerptOf(note);

                return (
                  <article class="post-card">
                    <div class="post-meta">
                      <a class="category" href={categoryHref(categoryOf(note.id))}>
                        {categoryOf(note.id)}
                      </a>
                      <time datetime={date?.toISOString()}>{formatDate(date)}</time>
                      {note.data.draft && <span class="draft-badge">Draft</span>}
                    </div>
                    <h2>
                      <a href={postHref(note.id)}>{note.data.title || note.id}</a>
                    </h2>
                    {excerpt && <p class="summary">{excerpt}</p>}
                    {note.data.tags.length > 0 && (
                      <ul class="tag-list" aria-label="标签">
                        {note.data.tags.map((tag) => {
                          const normalizedTag = tag.trim();

                          if (!normalizedTag) {
                            return null;
                          }

                          return (
                            <li>
                              {normalizedTag.includes("/") ? (
                                normalizedTag
                              ) : (
                                <a href={tagHref(normalizedTag)}>{normalizedTag}</a>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    <a class="read-more" href={postHref(note.id)}>阅读更多</a>
                  </article>
                );
              })}
            </div>
          )}

          <p class="browse-categories">
            <a href={withBase("/categories")}>按目录浏览全部分类</a>
          </p>
        </>
      )
    }
  </section>
</BaseLayout>
